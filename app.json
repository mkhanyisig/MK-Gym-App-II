{
  "expo": {
    "name": "My Form",
    "slug": "gym-buddy-v2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mkhanyisig.gymbuddyv2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E0E0D",
        "foregroundImage": "./assets/brand/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": ["expo-router", "expo-status-bar", "expo-font", "expo-sqlite"],
    "scheme": "gymbuddy",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "9fd9c730-6eef-4856-a5c1-4c48d2117886"
      }
    }
  }
}
